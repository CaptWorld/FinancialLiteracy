{
  "name": "paisa-sense",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check-content": "vitest run tests/content.test.ts",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply paisa-sense --remote"
  },
  "dependencies": {
    "marked": "^16.4.1",
    "preact": "^10.27.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.156.1"
  }
}
